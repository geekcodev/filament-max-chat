# Эталон имён переменных плагина, а не готовый .env для копирования целиком.
# Переносите в .env хост-приложения только те строки, которые меняете: заданная
# переменная перекрывает дефолт из config/filament-max-chat.php, а у булевых
# ключей пустое значение (KEY=) читается как false — например,
# MAX_CHAT_UPDATES_AUTO_HANDLE= выключил бы автообработку апдейтов, хотя по
# умолчанию она включена. Булевы ключи задавайте явно: true/false.

# Права доступа (строки проверяются через $user->can(...) — совместимо со spatie/laravel-permission и Gate).
# Схема имён как в laravel-max-client: MAX_PERMISSION_<RESOURCE>_<ABILITY>.
# max_chat.view — доступ к странице чата и вложениям (право реестра max_chat.view);
# max_chat.answer — отправка ответов оператора.
MAX_PERMISSION_CHAT_VIEW=
MAX_PERMISSION_CHAT_ANSWER=

# Private-канал Echo/Reverb для событий chat-message.created/updated/deleted/cleared и chat-removed.
MAX_CHAT_BROADCAST_CHANNEL=

# Автообработка апдейтов MAX (создание/правка/удаление сообщения, очистка и удаление
# диалога, смена названия чата) плагином для таблицы max_chat_messages (по умолчанию включена).
MAX_CHAT_UPDATES_AUTO_HANDLE=

# Модель оператора (персонала) для связи operator_id в max_chat_messages.
# По умолчанию Illuminate\Foundation\Auth\User — переопределяйте своей моделью (App\Models\User).
MAX_CHAT_USER_MODEL=

# Приватный диск вложений: файлы отдаются только через авторизованный роут.
# disk — имя диска (config/filesystems.php); directory — каталог внутри диска;
# max_bytes — жёсткий лимит при скачивании входящих вложений из MAX;
# upload_max_kb — ограничение загрузки оператором (Livewire);
# mimes — whitelist расширений для загрузки (через запятую).
MAX_CHAT_ATTACHMENTS_DISK=
MAX_CHAT_ATTACHMENTS_DIRECTORY=
MAX_CHAT_ATTACHMENTS_MAX_BYTES=
MAX_CHAT_ATTACHMENTS_UPLOAD_MAX_KB=
MAX_CHAT_ATTACHMENTS_MIMES=

# Роут отдачи вложений и эндпоинт счётчика непрочитанного.
# enabled=false — оба роута не регистрируются;
# uri — путь с параметром {message}; login_url — редирект гостя;
# unread_count_uri — HTTP-poll уведомлений (JSON: unread_count, latest_max_chat_id).
MAX_CHAT_ROUTE_ENABLED=
MAX_CHAT_ROUTE_URI=
MAX_CHAT_ROUTE_LOGIN_URL=
MAX_CHAT_ROUTE_UNREAD_COUNT_URI=

# Уведомления: включение/выключение звука и browser push.
# poll_enabled — HTTP-poll счётчика как фолбэк к Echo (по умолчанию включён);
# poll_interval — интервал в секундах (по умолчанию 15).
MAX_CHAT_NOTIFICATIONS_ENABLED=
MAX_CHAT_NOTIFICATIONS_SOUND=
MAX_CHAT_NOTIFICATIONS_BROWSER=
MAX_CHAT_NOTIFICATIONS_POLL_ENABLED=
MAX_CHAT_NOTIFICATIONS_POLL_INTERVAL=

# Email-уведомления о непрочитанных чатах (по умолчанию выключены).
# enabled — вкл/выкл рассылку (нужен scheduler хост-приложения и MAIL_*);
# unread_after_minutes — сообщение считается «забытым» после N минут без
# прочтения (по умолчанию 5); to — общий список получателей через запятую,
# плюс письмо уходит оператору, последнему отвечавшему в чате.
MAX_CHAT_EMAIL_ENABLED=
MAX_CHAT_EMAIL_UNREAD_AFTER_MINUTES=
MAX_CHAT_EMAIL_TO=

# Профиль/аватар пользователя MAX (лоновая фоновая подгрузка через getChatMembers).
# enabled — вкл/выкл; prefetch — on_open | on_list | both;
# cache_ttl — сколько сек не перезапрашивать профиль (по умолчанию 86400);
# refresh_existing — обновлять профиль, если аватар уже есть (по умолчанию нет).
MAX_CHAT_PROFILE_ENABLED=
MAX_CHAT_PROFILE_PREFETCH=
MAX_CHAT_PROFILE_CACHE_TTL=
MAX_CHAT_PROFILE_REFRESH_EXISTING=
