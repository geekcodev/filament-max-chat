# Права доступа (строки проверяются через $user->can(...) — совместимо со spatie/laravel-permission и Gate).
FILAMENT_MAX_CHAT_PERMISSION_VIEW=
FILAMENT_MAX_CHAT_PERMISSION_ANSWER=

# Private-канал Echo/Reverb для события chat-message.created.
FILAMENT_MAX_CHAT_CHANNEL=

# Модель оператора (персонала) для связи operator_id в chat_messages.
# По умолчанию Illuminate\Foundation\Auth\User — переопределяйте своей моделью (App\Models\User).
FILAMENT_MAX_CHAT_USER_MODEL=

# Приватный диск вложений: файлы отдаются только через авторизованный роут.
# disk — имя диска (config/filesystems.php); directory — каталог внутри диска;
# max_bytes — жёсткий лимит при скачивании входящих вложений из MAX;
# upload_max_kb — ограничение загрузки оператором (Livewire);
# mimes — whitelist расширений для загрузки (через запятую).
FILAMENT_MAX_CHAT_DISK=
FILAMENT_MAX_CHAT_DIRECTORY=
FILAMENT_MAX_CHAT_MAX_BYTES=
FILAMENT_MAX_CHAT_UPLOAD_MAX_KB=
FILAMENT_MAX_CHAT_MIMES=

# Роут отдачи вложений и эндпоинт счётчика непрочитанного.
# enabled=false — оба роута не регистрируются;
# uri — путь с параметром {message}; login_url — редирект гостя;
# unread_count_uri — HTTP-poll уведомлений (JSON: unread_count, latest_bot_chat_id).
FILAMENT_MAX_CHAT_ROUTE_ENABLED=
FILAMENT_MAX_CHAT_ROUTE_URI=
FILAMENT_MAX_CHAT_LOGIN_URL=
FILAMENT_MAX_CHAT_UNREAD_COUNT_URI=

# Уведомления: включение/выключение звука и browser push.
# poll_enabled — HTTP-poll счётчика как фолбэк к Echo (по умолчанию включён);
# poll_interval — интервал в секундах (по умолчанию 15).
FILAMENT_MAX_CHAT_NOTIFICATIONS_ENABLED=
FILAMENT_MAX_CHAT_NOTIFICATIONS_SOUND=
FILAMENT_MAX_CHAT_NOTIFICATIONS_BROWSER=
FILAMENT_MAX_CHAT_NOTIFICATIONS_POLL_ENABLED=
FILAMENT_MAX_CHAT_NOTIFICATIONS_POLL_INTERVAL=
